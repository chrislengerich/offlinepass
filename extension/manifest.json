{
  "manifest_version": 3,
  "name": "offlinepass",
  "version": "0.1.0",
  "description": "Receive offlinepass QRFT pastes (security-key gated) and auto-fill them. Fully offline.",
  "action": {
    "default_title": "offlinepass"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  },
  "web_accessible_resources": []
}
{
  "manifest_version": 3,
  "name": "linuxpass",
  "version": "0.1.0",
  "description": "Receive linuxpass QRFT pastes (security-key gated) and auto-fill them. Fully offline.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "linuxpass"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  }
}

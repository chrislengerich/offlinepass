<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Git/SSH transport + OpenKeyChain API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The ROM kills the app while OpenKeyChain foregrounds during a
         decrypt; the exemption request needs this permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional screen-lock gate before unlock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Import-from-QRFT: camera scanner WebView. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility (Android 11+): bind OpenKeychain's OpenPGP
         service by explicit package + action. -->
    <queries>
        <package android:name="org.sufficientlysecure.keychain" />
        <intent>
            <action android:name="org.openintents.openpgp.IOpenPgpService2" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Offlinepass"
        android:allowBackup="false">
        <activity
            android:name=".spike.FakeLoginActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".spike.S1DecryptActivity"
            android:exported="false" />
        <activity
            android:name=".spike.S2SshActivity"
            android:exported="false" />
        <activity
            android:name=".spike.S3GitActivity"
            android:exported="false" />

        <!-- Sharing the re-encrypted spike output back to the desktop. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- THE OPAQUE THEME = THE SETTLED SHAPE: the framework's FOR-RESULT
             launch of a service-created auth PendingIntent is aborted by
             the system (the captured instant CANCELED result BEFORE the
             auth activity's onCreate, consuming the auth tracking; the
             relaunch then drops the real RESULT_OK) — REGARDLESS of the
             activity's task configuration or the intent flags (the system
             forces FLAG_ACTIVITY_NEW_TASK for the task-less creator). The
             result-carried dataset stays for the platforms that deliver
             it; on this ROM the fill happens on the re-focus: the opaque
             activity's onStop expires the stuck session and the next
             focus starts a FRESH fill request that serves the saved item
             first (the translucent experiment removed that expiry and
             left the session stuck — no sheet at all). -->
        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:exported="false"
            android:taskAffinity=""
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Offlinepass" />
        <service
            android:name=".autofill.OfflinepassAutofillService"
            android:exported="false"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>

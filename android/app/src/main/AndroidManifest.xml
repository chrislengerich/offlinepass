<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Git/SSH transport + OpenKeyChain API. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (Android 11+): bind OpenKeychain's OpenPGP
         service by explicit package + action. -->
    <queries>
        <package android:name="org.sufficientlysecure.keychain" />
        <intent>
            <action android:name="org.openintents.openpgp.IOpenPgpService2" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Linuxpass"
        android:allowBackup="false">
        <activity
            android:name=".spike.FakeLoginActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".spike.S1DecryptActivity"
            android:exported="false" />
        <activity
            android:name=".spike.S2SshActivity"
            android:exported="false" />
        <activity
            android:name=".spike.S3GitActivity"
            android:exported="false" />
        <activity
            android:name=".spike.FakeLoginActivity"
            android:exported="false" />

        <!-- Sharing the re-encrypted spike output back to the desktop. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.linuxpass.app.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".autofill.LinuxpassAutofillService"
            android:exported="false"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Git/SSH transport + OpenKeyChain API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The ROM kills the app while OpenKeyChain foregrounds during a
         decrypt; the exemption request needs this permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional screen-lock gate before unlock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Import-from-QRFT: camera scanner WebView. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility (Android 11+): bind OpenKeychain's OpenPGP
         service by explicit package + action. -->
    <queries>
        <package android:name="org.sufficientlysecure.keychain" />
        <intent>
            <action android:name="org.openintents.openpgp.IOpenPgpService2" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Offlinepass"
        android:allowBackup="false">
        <activity
            android:name=".spike.FakeLoginActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".spike.S1DecryptActivity"
            android:exported="false" />
        <activity
            android:name=".spike.S2SshActivity"
            android:exported="false" />
        <activity
            android:name=".spike.S3GitActivity"
            android:exported="false" />

        <!-- Sharing the re-encrypted spike output back to the desktop. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- THE TASK AFFINITY = EMPTY + THE TRANSLUCENT THEME: the auth
             lives in the framework's own launch (the finish = back to the
             form), the SAVE mode = the bottom flyup card over the form
             (the reveal/generate = no content = nothing flashes). -->
        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:exported="false"
            android:taskAffinity=""
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".autofill.OfflinepassAutofillService"
            android:exported="false"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the `profileable` build type only: lets profilers
     (simpleperf, perfetto, heap dumps) attach from the shell without the
     app being debuggable. Requires targetSdk 29+. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <profileable android:shell="true" />
    </application>
</manifest>
